# Copy to .env.local (git-ignored) for local development. For EAS builds set the same two
# names as EAS environment variables instead — see README "Supabase config". Without them the
# app builds and runs with sign-in switched off and reports kept on the device.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# 1 opens the app on fixture data, signed in, with no network needed.
# EXPO_PUBLIC_PREVIEW=1
