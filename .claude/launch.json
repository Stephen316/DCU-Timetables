{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "console",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100,
      "cwd": "web"
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 8081,
      "cwd": "mobile"
    },
    {
      "name": "mobile-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_PREVIEW=1",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082,
      "cwd": "mobile"
    },
    {
      "name": "mobile-preview-windows",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:EXPO_PUBLIC_PREVIEW='1'; npx.cmd expo start --web --port 8082"
      ],
      "port": 8082,
      "cwd": "mobile"
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14.2.4",
        "--listen",
        "4100",
        "site"
      ],
      "port": 4100
    }
  ]
}
