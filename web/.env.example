# Copy to .env.local. The two Supabase values are the same ones the iOS app reads from
# supabase.local.json — the anon key is public by design (RLS is the boundary).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only, and deliberately without a NEXT_PUBLIC_ prefix — that prefix would inline
# the key into the browser bundle. .env.local is gitignored, so this never reaches the
# repository and never reaches a deployment on its own: set it again in the hosting
# provider's environment variables, or /ask renders its setup notice in production while
# working fine locally. From console.mistral.ai → API keys.
MISTRAL_API_KEY=YOUR-MISTRAL-KEY
# Optional. Overrides mistral-small-latest for both splits and rotations.
# MISTRAL_MODEL=mistral-medium-latest

# Optional, and only for tools/rotation-harness.mts, which still scores Gemini against the
# same PDF for comparison. The console itself no longer calls Gemini.
# GEMINI_API_KEY=YOUR-AI-STUDIO-KEY
