<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app and the widget extension are separate processes; this group is the only
	     container both can open, and it is how the widgets get their data. The id must
	     match `WidgetSnapshotStore.appGroup`. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.stephenh.dcutimetable</string>
	</array>
</dict>
</plist>
